{
  "manifest_version": 3,
  "name": "Storellet CMS Chatroom",
  "version": "1.4.0",
  "description": "Search confirmed Storellet CMS Model Answers with AI fallback support.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://storellet-knowledge.storellet.com/*",
    "https://api.anthropic.com/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "Open Storellet CMS Chatroom"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  }
}
